<ui version="4.0">
 <class>EditDialog</class>
 <widget class="QDialog" name="EditDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>500</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Edit profile</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="serverGroup">
     <property name="title">
      <string>Server</string>
     </property>
     <layout class="QFormLayout" name="serverForm">
      <item row="0" column="0"><widget class="QLabel" name="labelLabel"><property name="text"><string>Profile name:</string></property></widget></item>
      <item row="0" column="1"><widget class="QLineEdit" name="labelEdit"/></item>
      <item row="1" column="0"><widget class="QLabel" name="serverLabel"><property name="text"><string>Server URL:</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="serverEdit"><property name="placeholderText"><string>https://gk-msk04.netcraze.pro</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="credentialsGroup">
     <property name="title">
      <string>Credentials</string>
     </property>
     <layout class="QFormLayout" name="credForm">
      <item row="0" column="0"><widget class="QLabel" name="usernameLabel"><property name="text"><string>Username:</string></property></widget></item>
      <item row="0" column="1"><widget class="QLineEdit" name="usernameEdit"/></item>
      <item row="1" column="0"><widget class="QLabel" name="passwordLabel"><property name="text"><string>Password:</string></property></widget></item>
      <item row="1" column="1"><widget class="QLineEdit" name="passwordEdit"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="camouflageGroup">
     <property name="title">
      <string>Anti-DPI camouflage</string>
     </property>
     <layout class="QVBoxLayout" name="camouflageLayout">
      <item>
       <widget class="QCheckBox" name="camouflageToggle">
        <property name="text">
         <string>Enable Keenetic anti-DPI camouflage (recommended)</string>
        </property>
        <property name="toolTip">
         <string>ON: HMAC-derived CSTP magic, X-S-/X-D- headers, /api/v1/session tunnel, TLS ClientHello scatter.
OFF: legacy AnyConnect compatibility mode (use only for stock Cisco SSL VPN endpoints).</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="camouflageForm">
        <item row="0" column="0"><widget class="QLabel" name="camouflageSecretLabel"><property name="text"><string>Camouflage secret:</string></property></widget></item>
        <item row="0" column="1"><widget class="QLineEdit" name="camouflageSecretEdit"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>32-char shared secret (matches server camouflage-secret)</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="tunnelUrlLabel"><property name="text"><string>Tunnel URL:</string></property></widget></item>
        <item row="1" column="1"><widget class="QLineEdit" name="tunnelUrlEdit"><property name="placeholderText"><string>/api/v1/session</string></property></widget></item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="advancedGroup">
     <property name="title">
      <string>Advanced</string>
     </property>
     <layout class="QFormLayout" name="advancedForm">
      <item row="0" column="0"><widget class="QLabel" name="reconnectLabel"><property name="text"><string>Reconnect timeout (s):</string></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="reconnectSpin"><property name="minimum"><number>5</number></property><property name="maximum"><number>3600</number></property><property name="value"><number>30</number></property></widget></item>
      <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="minimizeCheck"><property name="text"><string>Minimise GUI to tray on successful connect</string></property></widget></item>
