GUI-controlled split-tunnel for vpnc-script-win.js:
When openconnect-gui exports OC_NO_DEFAULT_ROUTE=1, the script skips every
step that would add a 0.0.0.0/0 route via the VPN — the interface still gets
its address, DNS is still configured, split-include routes (CISCO_SPLIT_INC)
are still added, but the default gateway stays on the physical NIC.

Applied by .github/workflows/build-openconnect.yml after wget of the upstream
GitLab script.

--- a/vpnc-script-win.js
+++ b/vpnc-script-win.js
@@ -149,6 +149,11 @@
     // the simplest way to behave correctly in all cases,
     // including when the INTERNAL_IP4_NETMASK is /0 or /32.
     var internal_ip4_netmask = env("INTERNAL_IP4_NETMASK") || "255.255.255.255";
+    // GUI-controlled split-tunnel: skip everything that would set a default
+    // route toward the VPN. openconnect-gui exports OC_NO_DEFAULT_ROUTE=1 when
+    // the profile's "Do not install default VPN route" checkbox is on.
+    var noDefaultRoute = env("OC_NO_DEFAULT_ROUTE") == "1";
+    if (noDefaultRoute) echo(INFO, "OC_NO_DEFAULT_ROUTE=1 -> forcing split-tunnel");
     var internal_gw = env("INTERNAL_IP4_ADDRESS");
 
     echo(INFO, "Legacy IP Internet gateway: " + gw4);
@@ -183,12 +188,12 @@
 
     echo(INFO, "Configuring \"" + env("TUNDEV") + "\" / " + env("TUNIDX") + " interface for Legacy IP...");
 
-    if (!env("CISCO_SPLIT_INC") && REDIRECT_GATEWAY_METHOD != 2) {
+    if (!env("CISCO_SPLIT_INC") && REDIRECT_GATEWAY_METHOD != 2 && !noDefaultRoute) {
         // Interface metric must be set to 1 in order to add a route with metric 1 since Windows Vista
         run("netsh interface ip set interface " + env("TUNIDX") + " metric=1 store=active");
     }
 
-    if (env("CISCO_SPLIT_INC") || REDIRECT_GATEWAY_METHOD > 0) {
+    if (env("CISCO_SPLIT_INC") || REDIRECT_GATEWAY_METHOD > 0 || noDefaultRoute) {
         run("netsh interface ip set address " + env("TUNIDX") + " static " +
             env("INTERNAL_IP4_ADDRESS") + " " + internal_ip4_netmask + " store=active");
     } else {
@@ -237,6 +242,8 @@
                 " " + internal_gw + " if " + env("TUNIDX"));
             echo(INFO, "Configured Legacy IP split-include route: " + network + "/" + netmasklen);
         }
+    } else if (noDefaultRoute) {
+        echo(INFO, "Skipped default route (OC_NO_DEFAULT_ROUTE=1)");
     } else if (REDIRECT_GATEWAY_METHOD == 1) {
         run("route add 0.0.0.0 mask 0.0.0.0 " + internal_gw + " metric 1");
         echo(INFO, "Configured Legacy IP default route.");