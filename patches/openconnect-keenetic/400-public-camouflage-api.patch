+/* Keenetic anti-DPI camouflage.
+ *
+ * When `secret` is a non-NULL non-empty string, the patched libopenconnect
+ * enables camouflage Level 2: HMAC-SHA256-derived CSTP magic bytes,
+ * X-S-* / X-D-* header renaming, cookie session= (vs webvpn=), XML
+ * `auth-request` root (vs config-auth), CONNECT /api/v1/session
+ * (vs /CSCOSSLC/tunnel), suppressed X-Transcend-Version, and TCP-scatter
+ * fragmentation of the TLS ClientHello.  `secret` is duplicated and freed
+ * automatically.  Passing NULL or "" disables the envelope. */
+void openconnect_set_camouflage_secret(struct openconnect_info *vpninfo, const char *secret);
 #ifdef __cplusplus
 }
 #endif
--- a/library.c
