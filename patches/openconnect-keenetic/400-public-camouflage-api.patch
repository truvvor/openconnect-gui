+/* Keenetic anti-DPI camouflage public setter. */
+void openconnect_set_camouflage_secret(struct openconnect_info *vpninfo, const char *secret)
+{
+	free(vpninfo->camouflage_secret);
+	vpninfo->camouflage_secret = (secret && *secret) ? strdup(secret) : NULL;
+}
