 #include <stdio.h>
 #include <stdarg.h>
 
+#include <gnutls/crypto.h>
+
+/* Camouflage mode: set via --camouflage-secret option.
+ * When enabled, modifies CSTP framing and header names to evade DPI. */
+static int camouflage_enabled(struct openconnect_info *vpninfo)
+{
+	return vpninfo->camouflage_secret != NULL;
+}
+
+/* Derive CSTP magic bytes from camouflage secret */
+static void compute_cstp_magic(struct openconnect_info *vpninfo, char *magic)
+{
+	if (vpninfo->camouflage_secret) {
+		uint8_t hmac[32];
+		gnutls_hmac_fast(GNUTLS_MAC_SHA256,
+			vpninfo->camouflage_secret,
+			strlen(vpninfo->camouflage_secret),
+			"cstp-magic", 10, hmac);
+		magic[0] = hmac[0];
+		magic[1] = hmac[1];
+		magic[2] = hmac[2];
+		magic[3] = hmac[3];
+	} else {
+		magic[0] = 'S';
+		magic[1] = 'T';
+		magic[2] = 'F';
+		magic[3] = 1;
+	}
+}
+
